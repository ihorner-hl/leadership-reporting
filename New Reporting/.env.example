# Copy this file to `.env` and fill in the token. `.env` is gitignored — NEVER commit a real token.
#
# Create a HubSpot Private App (Settings -> Integrations -> Private Apps) with READ-ONLY scopes:
#   crm.objects.deals.read
#   crm.objects.line_items.read      (for deal amounts, if needed)
#   crm.objects.quotes.read
#   crm.objects.leads.read
#   tickets                          (ticket read)
#   crm.objects.companies.read
#   crm.objects.custom.read          (the Professional Services custom object)
#   crm.objects.owners.read
#   crm.schemas.custom.read
#   crm.objects.goals.read           (Sales Goals / targets — for pace vs target)
# The app needs NO write scopes — this dashboard only reads.

HUBSPOT_TOKEN=

# Optional: expose on your LAN (default unset = localhost only)
# HOST=0.0.0.0
